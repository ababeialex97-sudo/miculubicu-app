# Base URL of the WordPress site that runs the mlb-app-api plugin.
EXPO_PUBLIC_API_URL=https://miculubicu.ro/wp-json/mlb/v1

# Privacy policy page, linked from the Account screen and required in both stores.
EXPO_PUBLIC_PRIVACY_URL=https://miculubicu.ro/politica-de-confidentialitate/

# "Continuă cu Google" (optional): OAuth client IDs from Google Cloud, made on the client's account.
# The Web application client ID must also be entered in WordPress › WooCommerce › Setări aplicație.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
